# Help: Highly tuned config for AMD Ryzen 7000 (Zen 4 / znver4), e.g. 7950X
#
# Apply on top of a base config (Ubuntu's running config or `defconfig`):
#   make ryzen-zen4.config
#
# Targets a desktop/workstation workload: low-latency PREEMPT, HZ=1000,
# AMD P-State EPP via schedutil, MGLRU, BBR + FQ. Built with -march=native
# so the resulting kernel is specific to the build host's CPU.

# --- CPU / arch -------------------------------------------------------------
# Build with -march=native: emits znver4 codegen incl. AVX-512, VAES, GFNI.
CONFIG_X86_NATIVE_CPU=y

# Topology: Zen 4 has CCDs (and CCXes within); the cluster scheduler keeps
# tasks within an L3 complex, cutting cross-CCD coherency traffic.
CONFIG_SCHED_MC=y
CONFIG_SCHED_CLUSTER=y
CONFIG_SCHED_AUTOGROUP=y

# --- Preemption / timers ----------------------------------------------------
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# --- cpufreq / power --------------------------------------------------------
# AMD P-State in active mode (3) gives EPP hints to the firmware CPPC for
# the fastest p-state transitions on Zen 3+.
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3
# CONFIG_X86_AMD_PSTATE_UT is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# --- Memory -----------------------------------------------------------------
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# Single-socket UMA chip; balancing just adds overhead.
# CONFIG_NUMA_BALANCING is not set

# --- Networking -------------------------------------------------------------
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=m

# --- Block I/O --------------------------------------------------------------
CONFIG_MQ_IOSCHED_KYBER=y
CONFIG_IOSCHED_BFQ=y

# --- AMD platform / sensors / perf -----------------------------------------
CONFIG_AMD_NB=y
CONFIG_AMD_IOMMU=y
CONFIG_AMD_PMC=y
CONFIG_AMD_HSMP=m
CONFIG_AMD_PMF=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_PERF_EVENTS_AMD_UNCORE=y
CONFIG_PERF_EVENTS_AMD_BRS=y
CONFIG_PERF_EVENTS_AMD_POWER=m

# --- Crypto accel (AES-NI / PCLMUL / SHA-NI work on Zen) -------------------
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_GHASH_CLMUL_NI_INTEL=y
CONFIG_CRYPTO_CRC32C_INTEL=y
CONFIG_CRYPTO_CRCT10DIF_PCLMUL=y
